POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=120

# GROQ_API_KEY is never written here: compose passes it through from the shell.
GROQ_MODEL_GENERATION=openai/gpt-oss-120b
GROQ_MODEL_ROUTING=openai/gpt-oss-20b

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

DATA_DIR=/app/data
CIRCULARS_DIR=/app/data/circulars
CHUNKS_PATH=/app/ingest_out/chunks.jsonl

# Change only if the EC2 pre-built image has a different tag.
BASE_IMAGE=base_image:1.0
